# Ponytail plugin — installed per-machine via the plugin marketplace, not vendored here.
# Enablement is committed in .claude/settings.json; see CLAUDE.md for the one-time setup.
ponytail/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

graphify-out/

# Trained model checkpoints (809 MB Donut weights) — loaded by local path, never committed (ADR-0010)
models/

# Real InBody sheets and anything derived from them (hand-written labels
# included). These are one consenting subject's health data and carry a member
# ID and a gym name; ADR-0011 keeps health data out of the repo. The eval doc
# already describes data/real_holdout/ as uncommitted -- this is what makes
# that true.
data/
