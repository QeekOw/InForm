# Copy to .env for local development and fill in real values — .env is gitignored, this file is not.

# Postgres connection string (Neon or otherwise). Accounts & History (issues #41-#44).
#
# On Neon specifically: use the DIRECT connection string (hostname WITHOUT
# "-pooler"), not the pooled one. Neon's pooler runs PgBouncer in transaction
# mode, which returns the underlying server connection to the pool after each
# transaction — that's incompatible with holding one transaction open across
# several statements, which both this app's request-scoped session and the
# test suite's rolled-back-transaction fixture (tests/conftest.py) rely on.
# The direct connection string is in the same Neon dashboard, toggle
# "Connection pooling" off to reveal it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signing secret for session JWTs (issue #41). Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every existing session.
SESSION_SECRET=change-me-to-a-random-secret

# The session cookie needs Secure + SameSite=None for the real cross-site
# deployment (frontend on Vercel, backend on Render) — but browsers refuse
# both over plain http://, which local dev uses. Set to "true" only for local
# development against http://localhost; never set this in production.
ALLOW_INSECURE_COOKIES=true

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). No wildcard is possible once allow_credentials=True
# (issue #41) — browsers reject that combination outright. Defaults to
# http://localhost:3000 (Next.js dev) if unset; production must set this to
# the real deployed frontend origin(s).
ALLOWED_ORIGINS=http://localhost:3000,https://in-form-chi.vercel.app

# Google OAuth (issue #82). Leave all three unset until a Google Web OAuth
# client is configured. The redirect URI must exactly match the URI registered
# in Google Cloud and point to this backend, not the frontend.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# FRONTEND_URL=http://localhost:3000

# OPTIONAL, AND OFF BY DEFAULT. Module 4's written plan (issue #36).
#
# Leave this unset and the app behaves exactly as it ships: the narrative is
# assembled locally from a fixed template, labelled "Plain plan", and nothing
# about anyone's body leaves this host.
#
# Set it and every plan request sends that person's body-composition figures —
# weight, body fat, lean mass, limb-by-limb muscle, their goal and their age — to
# OpenAI, where this project's privacy posture stops applying. ADR-0005 scopes
# that to synthetic or explicitly consented data only. Do not set it on a
# deployment where real people are entering their own sheets.
#
# It also costs money per request, and `load_dotenv()` puts anything in the real
# .env into the test suite's environment too, so a key sitting here will be
# picked up by `pytest` and billed.
#
# The narrative never invents a number either way: validate_no_mutation drops any
# LLM response that alters a computed figure and falls back to the plain plan.
# OPENAI_API_KEY=sk-...
